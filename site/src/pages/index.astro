---
import {
  Badge,
  Badges,
  BuildOutput,
  CodeBlock,
  Facts,
  Features,
  Hero,
  Install,
  Quickstart,
  Terminal,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { formatReport, report } from '../showcase';

// Both outputs are html-conform's own findings for files in examples/showcase/.
const tableFindings = formatReport(report('table-grid'), 60);
const cspFindings = formatReport(report('csp-and-scripts'));

const mainRs = `use std::error::Error;

fn main() -> Result<(), Box<dyn Error>> {
    let html = std::fs::read_to_string("index.html")?;
    let report = html_conform::check(&html)?;

    for finding in &report.findings {
        let at = finding.location.map(|l| l.to_string()).unwrap_or_default();
        println!("{:?} {at} {} {}", finding.severity, finding.rule_id, finding.message);
    }

    if report.has_errors() {
        std::process::exit(1);
    }
    Ok(())
}`;
---

<Base>
  <Hero
    title="HTML conformance checks inside your Rust build."
    lead="html-conform parses a document the way browsers do, then checks it against the W3C HTML schema, attribute microsyntaxes, ARIA and structural rules. It is tested against the Nu Html Checker's own test corpus and runs without a JVM, subprocess or network access."
  >
    <Install commands={[{ label: 'cargo', command: 'cargo add html-conform' }]} />
    <Badges>
      <Badge>MIT</Badge>
      <Badge>crates.io 0.2.1</Badge>
      <Badge>Rust 1.88+</Badge>
      <Badge>no JVM</Badge>
    </Badges>
    <Terminal slot="output" title="check(table-grid.html)" dots ansi={tableFindings} />
  </Hero>

  <Facts
    items={[
      { value: '4,655', label: 'vnu test fixtures in the differential test' },
      { value: '0', label: 'false positives on that corpus' },
      { value: '1', label: 'false negative, documented: CSS inside <style>' },
      { value: '6', label: 'finding sources in one report' },
    ]}
  />

  <Features
    items={[
      {
        title: 'Six layers, one report',
        body: 'Parser diagnostics, the RELAX NG schema with SVG and MathML, attribute microsyntaxes, Schematron co-constraints, script and CSP checks, and the table cell grid all return the same Finding: rule ID, severity, message and position.',
      },
      {
        title: 'Measured against vnu',
        body: 'The differential test runs every vendored vnu fixture through check() on each push and fails if false positives or false negatives rise above the recorded baseline.',
      },
      {
        title: 'A library, not a service',
        body: 'No JVM, no subprocess, no HTTP. The schema and the rules are embedded in the crate, so check() works the same in a test, a CLI or a server.',
      },
      {
        title: 'Serializable findings',
        body: 'CheckReport, Finding, Severity and SourceLocation implement serde Serialize and Deserialize. The showcase on this site is built from that JSON.',
      },
    ]}
  />

  <BuildOutput
    caption="Findings for examples/showcase/csp-and-scripts.html, written by cargo run --example findings and formatted for this page. The showcase has six more samples."
    file="examples/showcase/csp-and-scripts.json"
  >
    <Terminal ansi={cspFindings} />
  </BuildOutput>

  <Quickstart
    lead="Three steps from a dependency to a failing build on invalid markup. The documentation covers options, rule IDs and the comparison with vnu."
    steps={[
      'Add the crate with <code>cargo add html-conform</code>.',
      'Pass the document to <code>html_conform::check()</code>.',
      'Read <code>report.findings</code>, or ask <code>report.has_errors()</code>.',
    ]}
  >
    <CodeBlock code={mainRs} lang="rust" title="main.rs" label="Rust" />
  </Quickstart>
</Base>
